# 代理服务配置文件示例
# 复制此文件为 .env 并根据需要修改配置值

# ========== API 基础配置 ==========
# 客户端认证密钥（您自定义的 API 密钥，用于客户端访问本服务）
AUTH_TOKEN=sk-your-api-key

# 跳过客户端认证（仅开发环境使用）
SKIP_AUTH_TOKEN=false

# Z.AI 匿名用户模式
# false: 使用认证 Token 令牌，失败时自动降级为匿名请求
# true: 自动从 Z.ai 获取临时访问令牌，避免对话历史共享
ANONYMOUS_MODE=true

# 是否使用客户端传递的 api_key 作为 Z.AI 认证 token
# true: 使用客户端传递的 api_key（需要 SKIP_AUTH_TOKEN=false 或客户端传递有效 token）
# false: 使用预配置的 token 或匿名模式
USE_CLIENT_TOKEN=false

# ========== 服务器配置 ==========
# 服务监听端口
LISTEN_PORT=8080

# 服务名称（用于进程唯一性验证）
SERVICE_NAME=z-ai2api-server

# 调试日志
DEBUG_LOGGING=false

# Function Call 功能开关
TOOL_SUPPORT=true

# 工具调用扫描限制（字符数）
SCAN_LIMIT=200000


# 是否自动删除上游会话
AUTO_DELETE_UPSTREAM_CHAT=true


# ========== Z.AI 签名配置 ==========
# Z.AI API 签名密钥（用于生成请求签名）
ZAI_SIGNATURE_KEY=junjie

# X-FE-Version 头配置
X_FE_VERSION=prod-fe-1.1.12
