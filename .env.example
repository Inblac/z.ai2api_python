# 代理服务配置文件示例
# 复制此文件为 .env 并根据需要修改配置值

# ========== API 基础配置 ==========
# 客户端认证密钥（您自定义的 API 密钥，用于客户端访问本服务）
AUTH_TOKEN=sk-your-api-key

# Z.AI 匿名用户模式
# false: 不自动获取匿名令牌；请求必须传入非 AUTH_TOKEN 的 Bearer token
# true: 自动从 Z.ai 获取临时访问令牌，避免对话历史共享
ANONYMOUS_MODE=true

# Authorization 令牌识别规则：
# 1. 未传 Authorization 或 Bearer 值等于 AUTH_TOKEN：使用匿名模式
# 2. Bearer 值不等于 AUTH_TOKEN：作为 Z.AI token 透传

# ========== 服务器配置 ==========
# 服务监听端口
LISTEN_PORT=8080

# 服务名称（用于进程唯一性验证）
SERVICE_NAME=z-ai2api-server

# 调试日志
DEBUG_LOGGING=false

# Function Call 功能开关
TOOL_SUPPORT=true

# 请求结束后是否批量删除账号下所有 Z.AI 上游 default 会话
AUTO_DELETE_UPSTREAM_CHAT=true

# ========== Z.AI 签名配置 ==========
# Z.AI API 签名密钥（用于生成请求签名）
ZAI_SIGNATURE_KEY=junjie

# X-FE-Version 头配置
X_FE_VERSION=prod-fe-1.1.22
